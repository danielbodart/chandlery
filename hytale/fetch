#!/bin/sh
# Populate staging ($1) with the Hytale server for the pinned version.
#
# Every Hytale asset is gated behind OAuth and a signed, per-request URL
# (PLAN 7.1), so the fetch needs a downloader *access* token. Mint one on the
# host with tools/hytale-token and pass it as HYTALE_ACCESS_TOKEN; it is needed
# only on the first start of a version, because /cache keeps the rest.
set -eu

staging=$1
: "${HYTALE_VERSION:?HYTALE_VERSION is not set}"
: "${HYTALE_PATCHLINE:=release}"
log() { printf '[hytale] %s\n' "$*" >&2; }

token="${HYTALE_ACCESS_TOKEN:-}"
if [ -z "$token" ]; then
    log "ERROR: HYTALE_ACCESS_TOKEN is not set, and $HYTALE_VERSION is not cached."
    log 'ERROR: mint one on the host and inject it for the first start of a'
    log 'ERROR: version:  -e HYTALE_ACCESS_TOKEN="$(tools/hytale-token)"'
    exit 78
fi

api="${HYTALE_ACCOUNT_API:-https://account-data.hytale.com}"

# Ask which build the patchline is on, and where its assets are. This endpoint
# is authenticated — unauthenticated it 403s (PLAN 7.1). A plain token UA, for
# the same Azure-CDN reason Bedrock needs one.
#
# NOTE: the exact field names of version/<patchline>.json are the one thing not
# yet verified against a live authenticated response (the plan reached the 403,
# not the body). They are isolated to these two jq lines so a single correction
# finalises the fetch once a downloader token is in hand.
log "resolving $HYTALE_PATCHLINE $HYTALE_VERSION"
meta=$(curl -fsS -A chandlery/hytale -H "authorization: Bearer $token" \
        "$api/version/$HYTALE_PATCHLINE.json")

got_version=$(printf '%s' "$meta" | jq -r '.version // .buildVersion // empty')
asset_url=$(printf '%s' "$meta" | jq -r '.url // .downloadUrl // .assetUrl // empty')

# Fail closed if the patchline has moved off the version this image pins: the
# tag must never fetch something else. CI rebuilds the image on a new version.
if [ -n "$got_version" ] && [ "$got_version" != "$HYTALE_VERSION" ]; then
    log "ERROR: $HYTALE_PATCHLINE is on $got_version, but this image pins $HYTALE_VERSION."
    exit 65
fi
[ -n "$asset_url" ] || { log "no asset URL in the version metadata"; exit 65; }

log "downloading assets (this is large — Assets.zip alone is ~3.3 GB)"
arc="$staging/.hytale.zip"
curl -fsSL -A chandlery/hytale --retry 5 --retry-all-errors --retry-max-time 1800 \
     -o "$arc" "$asset_url"
unzip -q "$arc" -d "$staging"
rm -f "$arc"

# A server jar is what proves the download produced something runnable.
find "$staging" -maxdepth 2 -name '*.jar' | grep -q . \
    || { log "no server jar in the download"; exit 65; }
