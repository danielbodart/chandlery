#!/bin/sh
# Ask the server to shut down cleanly, through the console the base wired to its
# stdin. argv[1] is the server pid; we do not need it — the entrypoint waits.
#
# `/stop` is the command, verified on a live 0.5.9 server: it shuts the plugins
# down in order, saves config and the world, logs "Shutdown completed!" and
# exits 0. The slash matters — the console is the same command surface as /auth
# and /help. (The server has no documented SIGTERM handler; this in-band stop is
# what saves before exit, which is the whole point of the hook.)
set -eu
chandlery-console /stop
