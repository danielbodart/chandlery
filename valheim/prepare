#!/bin/sh
# Runs as the game user before the server starts. Valheim refuses to start on
# several conditions and is vague about which; check them here where we can say
# something useful.
set -eu

log() { printf '[valheim] %s\n' "$*" >&2; }

if [ -z "${VALHEIM_PASSWORD:-}" ]; then
    log "ERROR: VALHEIM_PASSWORD is not set, and the server will not start without one."
    log "ERROR: pass -e VALHEIM_PASSWORD=... (at least 5 characters)."
    exit 78
fi

# Both of these make the server exit during startup with little explanation.
if [ "${#VALHEIM_PASSWORD}" -lt 5 ]; then
    log "ERROR: VALHEIM_PASSWORD must be at least 5 characters; it is ${#VALHEIM_PASSWORD}."
    exit 78
fi

world="${VALHEIM_WORLD:-Dedicated}"
case "$world" in
    *"$VALHEIM_PASSWORD"*)
        log "ERROR: the password cannot appear inside the world name ($world)."
        log "ERROR: Valheim rejects this, and does not say so clearly."
        exit 78
        ;;
esac

# First start fetches the pinned build into /cache; later starts reuse it. The
# cache is keyed by the manifest gid, so a build id that re-points at new bytes
# is a different key and refetches, while the same bytes are never pulled twice.
: "${VALHEIM_MANIFEST_GID:?VALHEIM_MANIFEST_GID is not set; this image is misbuilt}"
chandlery-cache valheim "$VALHEIM_MANIFEST_GID" /usr/local/lib/chandlery/fetch >/dev/null

mkdir -p /data/worlds_local
