#!/bin/sh
# Populate the staging directory chandlery-cache hands us ($1) with Valheim,
# using DepotDownloader to fetch exactly the pinned manifest.
#
# Anonymous login cannot download this depot ("No subscription"), and rollback
# needs old manifests, so the fetch authenticates with the operator's own
# licensed Steam account. The credential is DepotDownloader's portable token
# (its ~640-byte account.config), injected at runtime — the image carries none:
#
#   STEAM_USERNAME       the account's username (not a secret)
#   STEAM_LOGIN_SECRET   path to the account.config file (default /run/secrets/steam-login)
#   STEAM_LOGIN_TOKEN    OR base64 of account.config, for a plain env var
#
# Only the first fetch of a gid needs these; /cache keeps the rest.
set -eu

staging=$1
: "${VALHEIM_APP_ID:?VALHEIM_APP_ID is not set}"
: "${VALHEIM_DEPOT_ID:?VALHEIM_DEPOT_ID is not set}"
: "${VALHEIM_MANIFEST_GID:?VALHEIM_MANIFEST_GID is not set}"
log() { printf '[valheim] %s\n' "$*" >&2; }

DD=/opt/depotdownloader/DepotDownloader

user="${STEAM_USERNAME:-}"
[ -n "$user" ] || { log "ERROR: STEAM_USERNAME is not set (the licensed Steam account)."; exit 78; }

# Resolve the token: base64 env wins, else the mounted file.
secret="${STEAM_LOGIN_SECRET:-/run/secrets/steam-login}"
tokenfile="$staging/.token"
if [ -n "${STEAM_LOGIN_TOKEN:-}" ]; then
    printf '%s' "$STEAM_LOGIN_TOKEN" | base64 -d > "$tokenfile" 2>/dev/null \
        || { log "ERROR: STEAM_LOGIN_TOKEN is not valid base64."; exit 78; }
elif [ -f "$secret" ]; then
    cp "$secret" "$tokenfile"
else
    log "ERROR: no Steam login token. Provide the licensed account's DepotDownloader"
    log "ERROR: account.config as a mounted file ($secret) or base64 in STEAM_LOGIN_TOKEN."
    log "ERROR: Anonymous login cannot download this depot."
    exit 78
fi

# DepotDownloader keeps its token in .NET IsolatedStorage, at a path derived from
# the binary's location — so we cannot hardcode it. A harmless anonymous run
# creates the store; we drop the operator's token into the AssemFiles dir it
# makes, then the authenticated run reuses it with no 2-factor prompt.
export HOME="$staging/.dd-home"
mkdir -p "$HOME"
"$DD" -app "$VALHEIM_APP_ID" -manifest-only >/dev/null 2>&1 || true
ass=$(find "$HOME" -type d -name AssemFiles 2>/dev/null | head -1)
[ -n "$ass" ] || { log "DepotDownloader did not initialise its credential store"; exit 70; }
cp "$tokenfile" "$ass/account.config"
rm -f "$tokenfile"

log "downloading depot $VALHEIM_DEPOT_ID manifest $VALHEIM_MANIFEST_GID via DepotDownloader"
"$DD" -app "$VALHEIM_APP_ID" -depot "$VALHEIM_DEPOT_ID" -manifest "$VALHEIM_MANIFEST_GID" \
      -username "$user" -remember-password -dir "$staging/.dl" \
    || { log "DepotDownloader failed — token expired, or the account lacks the depot license"; exit 65; }

# Relocate the server up into the staging root, then drop DepotDownloader's
# scratch (its .dd-home store and the .DepotDownloader bookkeeping in .dl).
found=$(find "$staging/.dl" -type f -name valheim_server.x86_64 2>/dev/null | head -1)
[ -n "$found" ] || { log "no valheim_server.x86_64 in the download"; exit 65; }
src=$(dirname "$found")
if [ "$src" != "$staging" ]; then
    (cd "$src" && tar cf - --exclude='.DepotDownloader' .) | (cd "$staging" && tar xf -)
fi
rm -rf "$staging/.dd-home" "$staging/.dl"

chmod +x "$staging/valheim_server.x86_64"
test -x "$staging/valheim_server.x86_64" || { log "no runnable server after relocate"; exit 65; }
