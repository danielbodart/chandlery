#!/bin/sh
# Build-time only. Distribute a staging tree into N bucket dirs by a stable hash
# of each file's depth-2 subtree (resource_packs/vanilla, behavior_packs/foo, or
# a top-level file's own name), so every version bakes the same subtree into the
# same bucket. An unchanged subtree then lands in a byte-identical COPY layer the
# registry dedupes across versions; churn only re-pulls the bucket it falls in.
#
# Bounded (N layers, not one-per-pack) and adaptive (hashes names, so new packs
# and new version-stamped dirs need no Dockerfile edit). See bedrock/Dockerfile.
#
#   bucketize <src> <out> [N]
#
# Moves the contents of <src> into <out>/00 .. <out>/NN, mirroring the tree, so
# `COPY <out>/NN/ /opt/bedrock/` for each bucket reconstructs the whole tree.
set -eu

src=$1
out=$2
N=${3:-16}

# Resolved to absolute now, because the file loops below cd into <src> and would
# otherwise write buckets into <src>/<out>.
case $out in /*) ;; *) out=$PWD/$out ;; esac

# Every bucket must exist even if empty, so the Dockerfile's fixed COPY lines
# never reference a missing path.
i=0
while [ "$i" -lt "$N" ]; do
    mkdir -p "$out/$(printf '%02d' "$i")"
    i=$((i + 1))
done

# Hash the subtree name to a bucket. The top 8 hex of sha256 is plenty of spread
# for N in the tens, and $(( 0x.. )) keeps it to one arithmetic expansion.
bucket() {
    h=$(printf '%s' "$1" | sha256sum | cut -c1-8)
    printf '%02d' "$(( 0x$h % N ))"
}

cd "$src"

# Top-level files bucket on their own name.
for f in *; do
    [ -f "$f" ] || continue
    mv "$f" "$out/$(bucket "$f")/"
done

# Everything under a directory buckets on its depth-2 subtree (top/second), so a
# whole pack moves as a unit and deeper files inherit its bucket.
for top in */; do
    [ -d "$top" ] || continue
    top=${top%/}
    for child in "$top"/*; do
        [ -e "$child" ] || continue
        b=$(bucket "$child")
        mkdir -p "$out/$b/$top"
        mv "$child" "$out/$b/$top/"
    done
done
