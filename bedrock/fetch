#!/bin/sh
# Populate the staging directory chandlery-cache hands us ($1) with Bedrock.
#
# Downloads Mojang's versioned zip, verifies it against the sha256 the image
# pins, and unzips it. A checksum mismatch aborts non-zero: the image would
# rather fail to start than run bytes that are not the version on its tag. That
# is the whole difference from a runtime-download image — see PLAN 7.3.
set -eu

staging=$1
: "${BEDROCK_VERSION:?BEDROCK_VERSION is not set}"
url="${BEDROCK_URL:-https://www.minecraft.net/bedrockdedicatedserver/bin-linux/bedrock-server-${BEDROCK_VERSION}.zip}"

log() { printf '[bedrock] %s\n' "$*" >&2; }

zip="$staging/.bds.zip"
log "downloading Bedrock $BEDROCK_VERSION from $url"
# The User-Agent matters, and not obviously: Mojang's Azure CDN kills the HTTP/2
# stream ("stream not closed cleanly: INTERNAL_ERROR") for a UA it dislikes —
# curl's default, and, as measured, any UA carrying spaces or parentheses. A
# plain token UA gets a clean 200 over HTTP/2 with no other tricks.
# (itzg/docker-minecraft-bedrock-server#458.) Retries cover the CDN's real 503s.
curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors --retry-max-time 300 \
     -A chandlery/bedrock -o "$zip" "$url"

if [ -n "${BEDROCK_SHA256:-}" ]; then
    log "verifying sha256"
    echo "${BEDROCK_SHA256}  $zip" | sha256sum -c - >/dev/null
else
    log "WARNING: no BEDROCK_SHA256 pinned; running whatever the URL served"
fi

unzip -q "$zip" -d "$staging"
rm -f "$zip"

# Build-time leftovers that cannot run a game: the static link library, and the
# ~311 MB debug-symbols file older releases shipped.
rm -f "$staging/libMinecraft.Server.Lib.a" \
      "$staging/bedrock_server_debug_symbols.debug"

test -x "$staging/bedrock_server" || { log "no bedrock_server in the downloaded zip"; exit 65; }
