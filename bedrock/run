#!/bin/sh
# Become BDS, from the version baked into the image at /opt/bedrock.
#
# BDS reads its packs and dlopens its libraries relative to the working
# directory, so we cd into the game dir and put it on the library path before
# exec. exec matters: the entrypoint wired the console FIFO to this process's
# stdin, and the stop hook signals this pid expecting to reach the server.
set -eu

: "${BEDROCK_VERSION:?BEDROCK_VERSION is not set}"
game=/opt/bedrock

[ -x "$game/bedrock_server" ] || {
    echo "[bedrock] no bedrock_server baked at $game; this image is misbuilt" >&2
    exit 70
}

cd "$game"
export LD_LIBRARY_PATH=".:${LD_LIBRARY_PATH:-}"
exec ./bedrock_server
