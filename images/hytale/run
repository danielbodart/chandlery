#!/bin/sh
# Become the Hytale server, from the version baked into the image. exec matters:
# the entrypoint wired the console FIFO to this process's stdin, and the stop hook
# signals this pid.
#
# The official start.sh launches `java -jar Server/HytaleServer.jar
# --assets ../Assets.zip --backup …` from inside the Server/ directory, looping
# on exit code 8 to apply staged updates. We deliberately do NOT loop: the
# updater is off (HYTALE_DISABLE_UPDATES), because a container that rewrites its
# own binaries has stopped being the version on its tag (PLAN 7.1). We also run
# with the working directory on /data, so the world, config, logs and backups
# land on the volume rather than in the read-only game payload.
set -eu

: "${HYTALE_VERSION:?HYTALE_VERSION is not set}"
# The game is baked into the image.
game=/opt/hytale

jar="$game/Server/HytaleServer.jar"
# Assets are baked unzipped as a directory (the server takes --assets as
# DIR_OR_ZIP), so each asset buckets and dedupes across versions. Fall back to a
# baked Assets.zip if a build ever bakes the zip instead.
assets="$game/Assets"
[ -d "$assets" ] || assets="$game/Assets.zip"
[ -f "$jar" ]                        || { echo "[hytale] no server jar at $jar; this image is misbuilt" >&2; exit 70; }
[ -d "$assets" ] || [ -f "$assets" ] || { echo "[hytale] no assets at $game/Assets(.zip)" >&2; exit 70; }

# The server writes universe/, config.json, logs/, backups/ relative to the
# working directory; keep that on /data.
cd /data

# Server-session auth (PLAN 7.1). If a Treesinger broker is configured, mint a
# fresh session for this boot and hand it to the server through its OWN
# variables (HYTALE_SERVER_SESSION_TOKEN / _IDENTITY_TOKEN): the server reads
# those from the environment itself, so the JWTs never touch argv (world-readable
# via /proc). We fetch on every boot — the tokens are short-lived and the server
# self-refreshes from there, so a container recreated at any time comes up
# authenticated. If the broker cannot be reached we warn and boot unauthenticated:
# the same graceful state as no tokens at all, recoverable without a crash.
if [ -n "${TREESINGER_URL:-}" ]; then
    if resp=$(curl -fsS -m 10 -X POST "$TREESINGER_URL/v1/session" 2>/dev/null); then
        # Flat JSON: {"sessionToken":"…","identityToken":"…",…}. Extract without
        # jq (not in the image); JWTs are base64url + '.', never a '"', so
        # [^"]* is a safe field match.
        st=$(printf '%s' "$resp" | sed -n 's/.*"sessionToken":"\([^"]*\)".*/\1/p')
        it=$(printf '%s' "$resp" | sed -n 's/.*"identityToken":"\([^"]*\)".*/\1/p')
        if [ -n "$st" ] && [ -n "$it" ]; then
            export HYTALE_SERVER_SESSION_TOKEN="$st"
            export HYTALE_SERVER_IDENTITY_TOKEN="$it"
            echo "[hytale] authenticated via Treesinger ($TREESINGER_URL)" >&2
        else
            echo "[hytale] WARNING: Treesinger response carried no tokens; booting unauthenticated" >&2
        fi
    else
        echo "[hytale] WARNING: could not reach Treesinger at $TREESINGER_URL; booting unauthenticated" >&2
    fi
fi

# Assemble the launch, then append whatever arguments the container was given
# (compose `command:` / `docker run … <args>`) so extra or override flags pass
# straight through to the server with no env re-encoding — `--auth-mode offline`,
# `--bind host:port`, `--max-players 40`, anything the server accepts. "$@" here
# is still the container's own args: nothing has touched it yet.
#
# Auth stays off argv: the server reads its session tokens from the environment
# itself (HYTALE_SERVER_SESSION_TOKEN / HYTALE_SERVER_IDENTITY_TOKEN) — set by the
# Treesinger step above, injected directly by a deployer, or simply absent, in
# which case the server logs its own status and runs unauthenticated.
set -- -jar "$jar" --assets "$assets" --disable-sentry \
    --backup --backup-dir /data/backups --backup-frequency 30 "$@"

# JVM args go before -jar, so prepend them. A pre-trained AOT cache would cut
# boot time; 0.5.9 ships none, but honour one if a future build bakes it.
aot=$(find "$game" -maxdepth 3 -name 'HytaleServer.aot' 2>/dev/null | head -1)
[ -n "$aot" ] && set -- "-XX:AOTCache=$aot" "$@"
# Custom JVM options (heap, GC) via /data/jvm.options, one flag per line — the
# same @-file the official launcher reads, just from the volume.
[ -f /data/jvm.options ] && set -- "@/data/jvm.options" "$@"
set -- java "$@"

exec "$@"
