#!/bin/sh
# Runs as the game user before the server starts. The game is baked at
# /opt/valheim, so there is nothing to fetch — this only sanity-checks the baked
# payload and lays out /data.
#
# We do NOT validate the password (length, or that it is absent from the world
# name). Those are Valheim's own rules, which we do not own and which drift; when
# they are broken the server says so itself. Re-encoding them here would just be
# a second, staler copy to keep in sync.
set -eu

log() { printf '[valheim] %s\n' "$*" >&2; }

game=/opt/valheim
[ -x "$game/valheim_server.x86_64" ] || { log "no server baked at $game; this image is misbuilt"; exit 70; }

mkdir -p /data/worlds_local
