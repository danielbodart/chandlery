#!/bin/sh
# Steam's A2S_INFO query. Answering it proves the server is serving, which a
# port-bound check cannot tell you.
set -eu

# Valheim listens for queries on the game port plus one, and does not let you
# set the two independently.
port="${CHANDLERY_HEALTH_PORT:-$(( ${VALHEIM_PORT:-2456} + 1 ))}"

exec /usr/local/bin/chandlery-a2s -host 127.0.0.1 -port "$port"
