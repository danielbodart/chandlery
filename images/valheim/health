#!/bin/sh
# Steam's A2S_INFO query. Answering it proves the server is serving, which a
# port-bound check cannot tell you.
set -eu

# Valheim listens for queries on the game port plus one, and does not let you
# set the two independently. This probe runs inside the container against
# 127.0.0.1, so it sees the *container-internal* port — which is the default
# 2456 (query 2457) and stays put: you remap on the host side (-p 3456:2456),
# not inside. The only way to move the internal port is `command: [-port, N]`,
# which you would almost never do; if you do, override the healthcheck in compose
# to point at N+1. So there is one honest constant here, not a knob.
exec /usr/local/bin/chandlery-a2s -host 127.0.0.1 -port 2457
