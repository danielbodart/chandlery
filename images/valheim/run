#!/bin/sh
# Assemble the server's arguments from environment, then become the server.
#
# Valheim takes its whole configuration on the command line, so this is the
# adapter between "docker run -e" and that. exec matters: the stop hook signals
# this pid expecting to reach the server itself, not a shell holding its hand.
set -eu

: "${VALHEIM_NAME:=Chandlery}"
: "${VALHEIM_WORLD:=Dedicated}"
: "${VALHEIM_PORT:=2456}"
: "${VALHEIM_PUBLIC:=1}"

# The server is baked into the image.
game=/opt/valheim
[ -x "$game/valheim_server.x86_64" ] || {
    echo "[valheim] no server baked at $game; this image is misbuilt" >&2
    exit 70
}
cd "$game"

# Steam's client library looks up the *game's* app id, not the server's.
export SteamAppId=892970
export LD_LIBRARY_PATH="$game:${LD_LIBRARY_PATH:-}"

# Valheim's Steamworks loads steamclient.so from ~/.steam/sdk{64,32}; without it
# the server logs "Steam is not initialized" and its network backend never comes
# up. Use the current library baked beside the server at build (from SteamCMD),
# not the stale one in the depot (which fails with "Missing interface adapter for
# SteamGameServer015").
sc="$game/steamclient.so"
[ -f "$sc" ] || sc=$(find "$game" -name steamclient.so 2>/dev/null | head -1)
if [ -n "$sc" ] && [ -f "$sc" ]; then
    for d in "$HOME/.steam/sdk64" "$HOME/.steam/sdk32"; do
        mkdir -p "$d"; ln -sf "$sc" "$d/steamclient.so"
    done
fi

set -- ./valheim_server.x86_64 \
    -nographics -batchmode \
    -name "$VALHEIM_NAME" \
    -port "$VALHEIM_PORT" \
    -world "$VALHEIM_WORLD" \
    -password "$VALHEIM_PASSWORD" \
    -public "$VALHEIM_PUBLIC" \
    -savedir /data

# Valheim supports -savedir, so unlike Bedrock the world simply lives on the
# volume and the game directory stays read-only in spirit.

if [ -n "${VALHEIM_EXTRA_ARGS:-}" ]; then
    # Deliberately unquoted: the point is to let the caller pass several flags.
    # shellcheck disable=SC2086
    set -- "$@" $VALHEIM_EXTRA_ARGS
fi

exec "$@"
