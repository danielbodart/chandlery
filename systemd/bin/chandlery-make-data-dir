#!/bin/sh
# ExecStartPre=+ (as root, outside the sandbox, which needs the directory to
# exist before it can bind it): create a server's data directory owned by its
# user — but only if it is missing. An existing directory is never re-owned or
# re-moded: it may be an old install's world, owned the way its owner wants.
#
#   chandlery-make-data-dir DIR USER GROUP
set -eu

[ "$#" -eq 3 ] || { echo "usage: chandlery-make-data-dir DIR USER GROUP" >&2; exit 64; }
dir=$1 user=$2 group=$3

[ -d "$dir" ] && exit 0
printf '[chandlery] creating %s for %s:%s\n' "$dir" "$user" "$group" >&2
mkdir -p "$(dirname "$dir")"
install -d -m 0750 -o "$user" -g "$group" "$dir"
