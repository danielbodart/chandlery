#!/bin/sh
# Build-time only. Distribute a staging tree into N bucket dirs by a stable hash
# of each file's depth-<DEPTH> subtree, so every version bakes the same subtree
# into the same bucket. An unchanged subtree then lands in a byte-identical COPY
# layer the registry dedupes across versions; churn only re-pulls the bucket it
# falls in.
#
#   bucketize <src> <out> <N> [DEPTH]
#
# DEPTH is how many leading path components form the bucket key (default 2):
#   DEPTH=2  resource_packs/vanilla/**  -> key resource_packs/vanilla
#   DEPTH=4  Assets/Server/Prefabs/Npc/** -> key Assets/Server/Prefabs/Npc
# A whole depth-DEPTH subtree moves as one unit (its deeper files inherit its
# bucket); files shallower than DEPTH bucket on their own path. Shallower DEPTH
# keeps clustered churn together (fewer, coarser buckets); deeper DEPTH spreads a
# lopsided tree whose mass sits in a few deep branches (e.g. Hytale's assets).
#
# Bounded (N layers, not one-per-file) and adaptive (hashes paths, so new packs
# and version-stamped dirs need no Dockerfile edit). See build/bake-layout.
#
# Moves the contents of <src> into <out>/00 .. <out>/NN, mirroring the tree, so
# `COPY <out>/NN/ /opt/<game>/` for each bucket reconstructs the whole tree.
set -eu

src=$1
out=$2
N=$3
depth=${4:-2}

# Resolved to absolute now, because the loop below cds into <src> and would
# otherwise write buckets into <src>/<out>.
case $out in /*) ;; *) out=$PWD/$out ;; esac

# Every bucket must exist even if empty, so the Dockerfile's fixed COPY lines
# never reference a missing path.
i=0
while [ "$i" -lt "$N" ]; do
    mkdir -p "$out/$(printf '%02d' "$i")"
    i=$((i + 1))
done

# Hash the subtree path to a bucket. The top 8 hex of sha256 is plenty of spread
# for N in the tens, and $(( 0x.. )) keeps it to one arithmetic expansion.
bucket() {
    h=$(printf '%s' "$1" | sha256sum | cut -c1-8)
    printf '%02d' "$(( 0x$h % N ))"
}

cd "$src"

move() {  # $1 = a unit path like ./a/b — moved whole, keyed by its path
    rel=${1#./}
    dst="$out/$(bucket "$rel")/$(dirname "$rel")"
    mkdir -p "$dst"
    mv "$1" "$dst/"
}

# The bucket units: every entry at exactly depth <depth> (a dir moves whole, its
# deeper files inheriting its bucket; a file at that depth moves alone), plus any
# file shallower than <depth>. Enumerate first, then move — so moving a unit does
# not disturb the walk. (Game paths have no newlines.)
units=$(find . -mindepth "$depth" -maxdepth "$depth"
        [ "$depth" -gt 1 ] && find . -mindepth 1 -maxdepth "$((depth - 1))" -type f)
printf '%s\n' "$units" | while IFS= read -r u; do
    [ -n "$u" ] && [ -e "$u" ] && move "$u"
done
