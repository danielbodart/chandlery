#!/usr/bin/env bash
# Print a fresh Hytale downloader *access* token on stdout, refreshing it on
# demand and rotating the refresh token that backs it.
#
# The point: `$SOME_ENV` cannot run code, so it cannot self-refresh — a variable
# read is an expansion, not a call. This is the command-substitution answer.
# Use it wherever a fresh token is wanted, and it is minted at that moment:
#
#     docker run -e HYTALE_ACCESS_TOKEN="$(tools/hytale-token)" chandlery/hytale:...
#     curl -H "authorization: Bearer $(tools/hytale-token)" https://account-data.hytale.com/...
#
# What actually happens each call:
#   1. flock the store, so two concurrent calls cannot both spend the rotation.
#   2. If a cached access token is still comfortably valid, print it and stop —
#      no network, no rotation. This is why "use it every time" is cheap.
#   3. Otherwise POST grant_type=refresh_token, get a NEW access token AND a NEW
#      refresh token (Hytale rotates it and kills the old one), write all of it
#      back to the store *before* returning, and print the access token.
#
# Two stores, one behaviour:
#   - Local: a JSON file (HYTALE_TOKEN_FILE, default below) holding at least
#     {"refresh_token": "..."}; access_token and access_expires_at are added and
#     maintained here. This is the file you already made.
#   - CI: set HYTALE_DOWNLOADER_REFRESH_TOKEN in the env instead. The env cannot
#     be written back to, so the rotated refresh token is emitted to the file
#     named by HYTALE_REFRESH_WRITEBACK (and to $GITHUB_OUTPUT as
#     `refresh_token=` when present) for a later step to push into the secret.
set -euo pipefail

CLIENT_ID="${HYTALE_CLIENT_ID:-hytale-downloader}"
TOKEN_URL="${HYTALE_TOKEN_URL:-https://oauth.accounts.hytale.com/oauth2/token}"
# Default store lives out of the repo entirely, in the per-user config dir.
# Seed it once with {"refresh_token":"<from the device login>"}. Override with
# HYTALE_TOKEN_FILE; in CI set HYTALE_DOWNLOADER_REFRESH_TOKEN instead.
TOKEN_FILE="${HYTALE_TOKEN_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/chandlery/hytale.json}"
# Refresh when fewer than this many seconds of access-token life remain.
SKEW="${HYTALE_TOKEN_SKEW:-120}"

log() { printf 'hytale-token: %s\n' "$*" >&2; }
now() { date +%s; }

need() { command -v "$1" >/dev/null 2>&1 || { log "need $1 on PATH"; exit 69; }; }
need curl; need jq

# --- locate the store, and read the current refresh token ------------------
env_backed=0
if [ -n "${HYTALE_DOWNLOADER_REFRESH_TOKEN:-}" ]; then
    env_backed=1
    # A scratch file so the cache/writeback logic below is identical either way.
    TOKEN_FILE="${HYTALE_TOKEN_FILE:-$(mktemp)}"
    if [ ! -s "$TOKEN_FILE" ]; then
        ( umask 077; jq -n --arg rt "$HYTALE_DOWNLOADER_REFRESH_TOKEN" \
            '{refresh_token:$rt}' > "$TOKEN_FILE" )
    fi
elif [ ! -f "$TOKEN_FILE" ]; then
    log "no token store: set HYTALE_DOWNLOADER_REFRESH_TOKEN, or create $TOKEN_FILE"
    log 'with {"refresh_token":"<from the one-time device login>"}'
    exit 66
fi

# The store holds a credential; keep its directory and lock owner-only too.
( umask 077; mkdir -p "$(dirname "$TOKEN_FILE")" )

# Serialise everything below: the rotation is a read-modify-write on the store,
# and two of them at once means one refresh token is spent and lost.
( umask 077; : > "$TOKEN_FILE.lock" )
exec 9>"$TOKEN_FILE.lock"
flock 9

refresh_token=$(jq -r '.refresh_token // empty' "$TOKEN_FILE")
[ -n "$refresh_token" ] || { log "store has no refresh_token"; exit 66; }

# --- fast path: a still-valid cached access token --------------------------
access_token=$(jq -r '.access_token // empty' "$TOKEN_FILE")
expires_at=$(jq -r '.access_expires_at // 0' "$TOKEN_FILE")
if [ -n "$access_token" ] && [ "$(now)" -lt $(( expires_at - SKEW )) ]; then
    printf '%s\n' "$access_token"
    exit 0
fi

# --- refresh: spend the refresh token for a new pair -----------------------
log "refreshing access token"
# Pass the refresh token from an owner-only file, never on curl's command line:
# argv is world-readable via ps and /proc, and this is a bearer credential.
rtfile=$(mktemp); chmod 600 "$rtfile"
printf '%s' "$refresh_token" > "$rtfile"
resp=$(curl -fsS --http1.1 --retry 3 --retry-all-errors -X POST "$TOKEN_URL" \
        -d "client_id=$CLIENT_ID" \
        -d "grant_type=refresh_token" \
        --data-urlencode "refresh_token@$rtfile") || { rm -f "$rtfile"; log "token refresh failed"; exit 65; }
rm -f "$rtfile"

new_access=$(printf '%s' "$resp" | jq -r '.access_token // empty')
new_refresh=$(printf '%s' "$resp" | jq -r '.refresh_token // empty')
expires_in=$(printf '%s' "$resp" | jq -r '.expires_in // 3600')
[ -n "$new_access" ] || { log "no access_token in the response"; exit 65; }
# If the server did not rotate (some do not), keep the one we have.
[ -n "$new_refresh" ] || new_refresh="$refresh_token"

new_expires_at=$(( $(now) + expires_in ))

# Write the store back atomically, BEFORE the token is handed out, so a crash
# after this point cannot leave a spent refresh token as the stored one.
tmp=$(mktemp "$TOKEN_FILE.XXXXXX")
jq -n --arg rt "$new_refresh" --arg at "$new_access" --argjson exp "$new_expires_at" \
    '{refresh_token:$rt, access_token:$at, access_expires_at:$exp}' > "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$TOKEN_FILE"

# CI cannot write an env var back to its secret store; surface the rotated
# refresh token to a file a trusted step reads to update the secret via the API.
# Deliberately NOT via $GITHUB_OUTPUT: step outputs persist and are a poor place
# for a bearer credential. The file is created owner-only, atomically, so it is
# never briefly world-readable — same pattern as the store above.
if [ "$env_backed" = 1 ] && [ "$new_refresh" != "$refresh_token" ] \
   && [ -n "${HYTALE_REFRESH_WRITEBACK:-}" ]; then
    wtmp=$(mktemp "${HYTALE_REFRESH_WRITEBACK}.XXXXXX")
    chmod 600 "$wtmp"
    printf '%s\n' "$new_refresh" > "$wtmp"
    mv -f "$wtmp" "$HYTALE_REFRESH_WRITEBACK"
fi

printf '%s\n' "$new_access"
